# =============================================================================
# Edge Environment Configuration Example
# =============================================================================
# Copy this file to .env on the Jetson device:
#   cp .env.example .env
#
# Do not commit .env. Replace placeholder credentials before production use.
# This template is freezer-first and assumes a dual-top camera deployment.
# =============================================================================

# =============================================================================
# Environment
# =============================================================================
NODE_ENV=production

# =============================================================================
# Edge API and credentials
# =============================================================================
API_HOST=127.0.0.1
API_KEY=change-this-to-secure-key

USER_ID=
USER_PASSWORD=
JWT_TOKEN=
JWT_TOKEN_AT=

# =============================================================================
# Service URLs
# =============================================================================
IO_BOARD_URL=http://localhost:8000
CAMERA_DRIVER_URL=http://localhost:8003
NODEJS_URL=http://localhost:8888
PRODUCT_JUDGE_URL=http://localhost:8002
MQTT_CLIENT_URL=http://localhost:8006
REST_API=https://api.example.com

# =============================================================================
# MQTT
# =============================================================================
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_CLIENT_USERNAME=
MQTT_CLIENT_PASSWORD=

MQTT_URL=mqtt://localhost:1883
MQTT_USER=
MQTT_PASS=

# Optional TLS example. Keep disabled unless the broker requires TLS.
MQTT_USE_TLS=false
MQTT_CA_CERT=

# =============================================================================
# Device identity
# =============================================================================
DIVISION_IDX=DIV001
DEVICE_IDX=DEV001

# =============================================================================
# IO Board
# =============================================================================
IO_BOARD_PORT=/dev/ttyUSB0
IO_BOARD_BAUDRATE=38400

# =============================================================================
# Loadcell filtering used by the Edge services
# =============================================================================
LOADCELL_FILTER_METHOD=exponential
LOADCELL_FILTER_ALPHA=0.3
LOADCELL_CHANGE_THRESHOLD=50
LOADCELL_THRESHOLD_SCOPE=filtered

# =============================================================================
# Model service API
# =============================================================================
MODEL__API__HOST=0.0.0.0
MODEL__API__PORT=8002
MODEL__API__LOG_LEVEL=info

# Freezer mode keeps zone-sliced loadcells but makes identity vision-first.
# For dual-top freezer deployments, keep CAMERA_LAYOUT=dual_top_proxy.
MODEL__MACHINE__CABINET_TYPE=freezer

# TensorRT engine. The freezer field profile uses set7_v8best.engine.
MODEL__VISION__YOLO_MODEL_PATH=models/set7_v8best.engine
MODEL__VISION__YOLO_INTERNAL_CONF_THRESHOLD=0.01
MODEL__VISION__LOG_ENGINE_CLASSES=off

# Runtime catalog policy. Product identity is resolved from Node active_products
# against the loaded engine class names.
MODEL__CATALOG__SOURCE_POLICY=node_first
MODEL__CATALOG__PRODUCT_NAME_FALLBACK_ENABLED=true
MODEL__CATALOG__STATIC_VALIDATION_ENABLED=false

# =============================================================================
# Trigger/session buffers
# =============================================================================
MODEL__BUFFER__TTL_SECONDS=300
MODEL__BUFFER__MAX_SESSIONS=100
MODEL__BUFFER__CLEANUP_INTERVAL_SECONDS=60

MODEL__DOOR_SESSION__ENABLED=true
MODEL__DOOR_SESSION__SESSION_TIMEOUT_SECONDS=30.0
MODEL__DOOR_SESSION__WEIGHT_TOLERANCE_GRAMS=5.0
MODEL__DOOR_SESSION__MAX_DURATION_SECONDS=600.0
MODEL__DOOR_SESSION__YAML_RETENTION_DAYS=7
MODEL__DOOR_SESSION__YAML_DIR=data/sessions

# =============================================================================
# Vision candidate filtering
# =============================================================================
MODEL__VISION__TOP_K=10
MODEL__VISION__DIAGNOSTIC_ALL_CLASS_TRACE=true
MODEL__VISION__DIAGNOSTIC_TRACE_MAX_FRAMES=5

MODEL__VISION__CAMERA_LAYOUT=dual_top_proxy
MODEL__VISION__TOP_CROP_POLICY=left
MODEL__VISION__SIDE_CROP_POLICY=left
MODEL__VISION__TOP_ROI_ENABLED=true
MODEL__VISION__TOP_ROI_Y_SPLIT=240.0
MODEL__VISION__SIDE_ROI_X_MAX=400.0
MODEL__VISION__SIDE_ROI_SOFT_MARGIN_PX=5.0
MODEL__VISION__ROI_RESCUE_REQUIRE_MOTION=true
MODEL__VISION__ROI_RESCUE_MAX_OVER_LIMIT_PX=0.0
MODEL__VISION__TOP_CONFIDENCE_THRESHOLD=0.25
MODEL__VISION__SIDE_CONFIDENCE_THRESHOLD=0.25
MODEL__VISION__MIN_VOTE_RATIO=0.02
MODEL__VISION__MIN_VOTE_COUNT=1
MODEL__VISION__MOTION_MIN_DISPLACEMENT_PX=10.0

# Freezer-only dual-top filtering. Both public streams are treated as top views
# and keep detections whose 480x480 bbox center is in the upper half.
MODEL__VISION__FREEZER_MIN_VOTE_RATIO=0.08
MODEL__VISION__FREEZER_MIN_VOTE_COUNT=3
MODEL__VISION__FREEZER_MOTION_MIN_DISPLACEMENT_PX=12.0
MODEL__VISION__FREEZER_ROI_VERTICAL_REGION=upper
MODEL__VISION__FREEZER_ROI_Y_SPLIT=240.0
# Deprecated fallback alias. Prefer FREEZER_ROI_VERTICAL_REGION/Y_SPLIT.
# MODEL__VISION__FREEZER_LOWER_ROI_Y_SPLIT=240.0
MODEL__VISION__FREEZER_MIN_EXIT_PATH_VOTES=3

MODEL__VISION__THRESHOLD_RESCUE_ENABLED=true
MODEL__VISION__THRESHOLD_RESCUE_CONFIDENCE_CAP=0.18
MODEL__VISION__THRESHOLD_RESCUE_REQUIRE_MOTION=true
MODEL__VISION__THRESHOLD_RESCUE_MAX_CANDIDATES=20
MODEL__VISION__WEIGHT_RESCUE_NO_MOTION_ENABLED=true
MODEL__VISION__WEIGHT_RESCUE_NO_MOTION_MIN_RAW_VOTES=8
MODEL__VISION__WEIGHT_RESCUE_NO_MOTION_MAX_RESIDUAL_GRAMS=2.0

MODEL__VISION__CROP_WIDTH=480
MODEL__VISION__TOP_WEIGHT=0.60
MODEL__VISION__SIDE_WEIGHT=0.65
MODEL__VISION__TOP_ONLY_WEIGHT=0.55
MODEL__VISION__SIDE_ONLY_WEIGHT=0.60
MODEL__VISION__COMMON_CLASS_BONUS=0.20
MODEL__VISION__FFMPEG_TOP_GAMMA=1.2
MODEL__VISION__FFMPEG_TOP_CONTRAST=1.2
MODEL__VISION__FFMPEG_SIDE_GAMMA=1.0
MODEL__VISION__FFMPEG_SIDE_CONTRAST=1.0

# =============================================================================
# Async video processing
# =============================================================================
MODEL__ASYNC_STREAMING__ENABLED=true
MODEL__ASYNC_STREAMING__FRAME_QUEUE_SIZE=10
MODEL__ASYNC_STREAMING__FRAME_STRIDE=2

# =============================================================================
# Weight and freezer decision tuning
# =============================================================================
MODEL__WEIGHT__IDENTITY_POLICY=vision_first
MODEL__WEIGHT__FUSION_VISION_WEIGHT=0.65
MODEL__WEIGHT__FUSION_LOADCELL_WEIGHT=0.25
MODEL__WEIGHT__FUSION_COUNT_WEIGHT=0.10
MODEL__WEIGHT__STRICT_MODE=true
MODEL__WEIGHT__STRICT_MODE_FALLBACK=true
MODEL__WEIGHT__TOLERANCE_PERCENT=0.08
MODEL__WEIGHT__TOLERANCE_GRAMS=5.0
MODEL__WEIGHT__MULTI_KIND_MIN_CONFIDENCE=0.18
MODEL__WEIGHT__RESCUE_TOLERANCE_GRAMS=5.0
MODEL__WEIGHT__SAME_PRODUCT_COUNT_TOLERANCE_GRAMS=5.0
MODEL__WEIGHT__SAME_PRODUCT_MAX_COUNT=8
MODEL__WEIGHT__MAX_ITEMS_PER_SEGMENT=3
MODEL__WEIGHT__DETECTED_SINGLE_FALLBACK_ENABLED=true
MODEL__WEIGHT__DETECTED_SINGLE_FALLBACK_TOLERANCE_GRAMS=8.0
MODEL__WEIGHT__DETECTED_SINGLE_FALLBACK_MIN_VOTES=4

# Single freezer candidates use weight as a confidence-band tie-break. Multi
# freezer output must fit the measured delta inside the freezer tolerance.
MODEL__WEIGHT__FREEZER_CONFIDENCE_TIE_BAND=0.08
MODEL__WEIGHT__FREEZER_MULTI_MIN_CONFIDENCE=0.45
MODEL__WEIGHT__FREEZER_WEIGHT_TOLERANCE_GRAMS=15.0
MODEL__WEIGHT__FREEZER_VISION_MULTI_WITHOUT_WEIGHT_ENABLED=false

MODEL__WEIGHT__MIN_WEIGHT_CHANGE=5.0
MODEL__WEIGHT__MAX_COMBINATION_ITEMS=5
MODEL__WEIGHT__MAX_COMBINATION_SIZE=5
MODEL__WEIGHT__MAX_COMBINATION_KINDS=3
MODEL__WEIGHT__MAX_COUNT_PER_ITEM=10
MODEL__WEIGHT__MAX_COMBINATIONS=200
MODEL__WEIGHT__NEAREST_SINGLE_MARGIN_GRAMS=10.0

# =============================================================================
# Trigger behavior
# =============================================================================
MODEL__TRIGGER__LOW_WEIGHT_VISION_FALLBACK=true
MODEL__TRIGGER__RETURN_VIDEO_SKIP_ENABLED=true
MODEL__TRIGGER__RETURN_STABILIZATION_WAIT_SECONDS=1.0
MODEL__TRIGGER__RETURN_STABILIZATION_REQUIRE_STABLE_REGIONS=true
MODEL__TRIGGER__BALANCED_EVENT_CANCEL_ENABLED=true
MODEL__TRIGGER__COOPERATIVE_CANCEL_ENABLED=true
MODEL__TRIGGER__RAPID_SAME_ZONE_WINDOW_SECONDS=3.0

# =============================================================================
# Frame split trace
# =============================================================================
# Keep sample export disabled by default. Enabling it writes JPEG samples during
# inference and can add disk I/O on Jetson.
MODEL__TRACE__SAMPLE_EXPORT_ENABLED=false
MODEL__TRACE__SAMPLE_COUNT_PER_CAMERA=3
MODEL__TRACE__SAMPLE_EXPORT_DIR=logs/frame_samples

# Node.js Orchestrator callback target.
MODEL__NODEJS_URL=http://localhost:8888

# =============================================================================
# Camera service defaults
# =============================================================================
CAMERA_MODE=api
NVIDIA_MODE=true
CAMERA_RESOLUTION_WIDTH=640
CAMERA_RESOLUTION_HEIGHT=480
CAMERA_FPS=30
CAMERA_JPEG_QUALITY=80

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=INFO

# =============================================================================
# Card terminal
# =============================================================================
CARD_API_HOST=0.0.0.0
CARD_API_PORT=5000
CAT_HOST=0.0.0.0
CAT_PORT=5001
COMM_TIMEOUT=30
SHUTDOWN_TIMEOUT=10

# =============================================================================
# MongoDB
# =============================================================================
MONGO_URI=mongodb://localhost:27017/chai

# =============================================================================
# MinIO
# =============================================================================
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=change-this-minio-access-key
MINIO_SECRET_KEY=change-this-minio-secret-key
MINIO_USE_SSL=false
MINIO_BUCKET=chaiimage
