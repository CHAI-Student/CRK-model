# Edge Environment Docker 환경변수 템플릿
#
# Model Service 컨테이너용 환경 변수
# docker-compose.yml의 env_file로 로드됨
#
# Jetson Orin Nano 4GB 최적화 기본값

# ==============================================================================
# YOLO 모델 설정
# ==============================================================================

MODEL__API__HOST=0.0.0.0
MODEL__API__PORT=8002
MODEL__API__LOG_LEVEL=info

# ==============================================================================
# YOLO 모델 경로
# ==============================================================================

MODEL__VISION__YOLO_MODEL_PATH=/data/models/siyeon_best.engine

# ==============================================================================
# 세션 설정
# ==============================================================================

# 세션 TTL (초)
MODEL__BUFFER__TTL_SECONDS=300

# 최대 세션 수
MODEL__BUFFER__MAX_SESSIONS=100

# 자동 정리 간격 (초)
MODEL__BUFFER__CLEANUP_INTERVAL_SECONDS=60

# ==============================================================================
# Door Session 설정
# ==============================================================================

MODEL__DOOR_SESSION__ENABLED=true
MODEL__DOOR_SESSION__SESSION_TIMEOUT_SECONDS=30.0
MODEL__DOOR_SESSION__WEIGHT_TOLERANCE_GRAMS=3.0
MODEL__DOOR_SESSION__MAX_DURATION_SECONDS=600.0
MODEL__DOOR_SESSION__YAML_RETENTION_DAYS=7
MODEL__DOOR_SESSION__YAML_DIR=/data/sessions

# ==============================================================================
# Async Streaming 설정
# ==============================================================================

MODEL__ASYNC_STREAMING__ENABLED=true
MODEL__ASYNC_STREAMING__FRAME_QUEUE_SIZE=10

# ==============================================================================
# Node.js 연동
# ==============================================================================

# Docker 내부에서 호스트 접근 시: host.docker.internal
# 같은 Docker 네트워크면: http://nodejs:8888
MODEL__NODEJS_URL=http://host.docker.internal:8888

# ==============================================================================
# TensorRT 변환 컨테이너용 (convert 서비스)
# ==============================================================================

# 변환할 .pt 파일명
PT_FILE=siyeon_best.pt

# 입력 이미지 크기
IMGSZ=480
